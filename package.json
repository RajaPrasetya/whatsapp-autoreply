{
  "name": "whatsapp-autoreply",
  "version": "1.0.0",
  "description": "WhatsApp Auto Reply Service using Bun, Hono and WAHA API",
  "main": "src/index.ts",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "type-check": "tsc --noEmit"
  },
  "keywords": ["whatsapp", "auto-reply", "bun", "hono", "waha"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "hono": "^3.12.8",
    "@hono/node-server": "^1.8.2"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^20.10.6",
    "typescript": "^5.3.3"
  }
}
